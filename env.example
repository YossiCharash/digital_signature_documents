# Required – no defaults defined in config.py
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Email delivery backend: smtp (default) | ses | api
# Use "ses" on AWS to avoid Gmail's daily sending limit.
EMAIL_PROVIDER=ses

# Amazon SES (when EMAIL_PROVIDER=ses)
# SMTP_FROM_EMAIL above must be a verified SES identity in this region.
# On AWS App Runner/ECS/EC2 leave the keys empty to use the instance IAM role.
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=
# Optional SES configuration set (for bounce/complaint tracking)
SES_CONFIGURATION_SET=

# Secrets – must never be hardcoded
SMTP_PASSWORD=
EMAIL_API_KEY=
SMS_API_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
DATABASE_URL=
PRIVATE_KEY_PATH=
PRIVATE_KEY_PEM=
TSA_PASSWORD=
