# Required – no defaults defined in config.py
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Comma-separated "label:key" pairs, e.g. "acme:s3cr3t,globex:0th3r".
# The label identifies the caller in the logs and lets one caller's key be
# revoked without rotating everyone else's.
#
# While this is EMPTY, /api/v1/documents/* accepts unauthenticated requests
# (so already-distributed copies of api_client.ps1 keep working) and the app
# logs a warning on every startup. /api/v1/deliveries always requires a key.
# Set this once your clients send the X-API-Key header.
API_KEYS=

# Comma-separated browser origins allowed to call the API. Leave empty for a
# server-to-server deployment.
CORS_ORIGINS=

# Requests per window for /api/v1/documents/*. 0 disables the limit.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum accepted upload, in bytes (default 20 MB).
MAX_UPLOAD_BYTES=20971520

# Set false when the service is exposed directly rather than behind a proxy
# that overwrites X-Forwarded-For (Render, ALB, Cloudflare).
TRUST_PROXY_HEADERS=true

# Email delivery backend: smtp (default) | ses | sendgrid | mailjet | api
# Use "ses" on AWS, or "sendgrid"/"mailjet" anywhere else, to avoid Gmail's
# daily sending limit.
EMAIL_PROVIDER=mailjet

# Mailjet (when EMAIL_PROVIDER=mailjet) – Send API v3.1 over HTTPS.
# Both values come from the SAME row in Account > API Key Management.
# SMTP_FROM_EMAIL above must be authorised under Sender domains & addresses.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Set to true to validate requests without actually delivering mail.
MAILJET_SANDBOX_MODE=false

# SendGrid (when EMAIL_PROVIDER=sendgrid) – Web API v3 over HTTPS, so it works
# even where outbound SMTP ports are blocked.
# SMTP_FROM_EMAIL above must be a verified SendGrid sender identity.
SENDGRID_API_KEY=
# Optional – override only if you use the EU data residency endpoint:
# SENDGRID_API_URL=https://api.eu.sendgrid.com/v3/mail/send
# Set to true to validate requests without actually delivering mail.
SENDGRID_SANDBOX_MODE=false

# Amazon SES (when EMAIL_PROVIDER=ses)
# SMTP_FROM_EMAIL above must be a verified SES identity in this region.
# On AWS App Runner/ECS/EC2 leave the keys empty to use the instance IAM role.
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=
# Optional SES configuration set (for bounce/complaint tracking)
SES_CONFIGURATION_SET=

# Secrets – must never be hardcoded
SMTP_PASSWORD=
EMAIL_API_KEY=
SMS_API_KEY=
SMS_FROM_NUMBER=
S3_ACCESS_KEY=
S3_SECRET_KEY=
DATABASE_URL=
PRIVATE_KEY_PATH=
PRIVATE_KEY_PEM=
TSA_PASSWORD=
