# Required – no defaults defined in config.py
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Email delivery is via Amazon SES only.
EMAIL_PROVIDER=ses

# Amazon SES
# SMTP_FROM_EMAIL above must be a verified SES identity in this region.
# On AWS App Runner/ECS/EC2 leave the keys empty to use the instance IAM role.
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=
# Optional SES configuration set (for bounce/complaint tracking).
# Create one, add an SNS event destination for Bounce + Complaint, and point
# the SNS subscription at https://<your-host>/webhooks/ses so hard bounces and
# complaints auto-populate the suppression list.
SES_CONFIGURATION_SET=
# Verify the signature on inbound SNS webhooks (keep true in production).
SES_SNS_VERIFY_SIGNATURES=true

# Asynchronous email queue (durable outbox).
# When DATABASE_URL is set, sign-and-email enqueues the message and returns 202
# immediately; a background worker sends it and records the real outcome, which
# you can poll at GET /api/v1/emails/{job_id}. Without DATABASE_URL the endpoint
# falls back to sending inline. Set to false to force inline sending even with a DB.
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_POLL_SECONDS=10
EMAIL_QUEUE_BATCH_SIZE=10
EMAIL_QUEUE_MAX_ATTEMPTS=5
EMAIL_QUEUE_RETRY_BASE_SECONDS=60
EMAIL_QUEUE_RETRY_MAX_SECONDS=3600
EMAIL_QUEUE_SENT_RETENTION_DAYS=2

# Secrets – must never be hardcoded
SMS_API_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
DATABASE_URL=
PRIVATE_KEY_PATH=
PRIVATE_KEY_PEM=
TSA_PASSWORD=
